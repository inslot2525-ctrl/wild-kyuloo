# Copy to .env.local and fill in. Never commit real keys.

# Gemini API key, free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model overrides (both are on the free tier)
# GEMINI_MODEL=gemini-3.5-flash-lite   (or gemini-3.8-flash: stronger, but only ~20 free requests/day)
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Optional: a key that still has free Google Search on gemini-2.5-flash (newer keys don't).
# Without it, web search falls back to Wikipedia.
# GEMINI_SEARCH_API_KEY=

# Qloo event credential, read by the `qloo mcp` harness.
# Locally you can instead run `qloo setup --qloo` once and leave this empty.
# With no usable credential the app runs Qloo in mock mode.
QLOO_API_KEY=
# Hackathon keys only work on the hackathon server. Locally, run once:
#   qloo config set base-url https://hackathon.api.qloo.com

# Hackathon keys only work on the hackathon server (the harness defaults to
# production, which rejects them). Locally, `qloo config set base-url` does the same.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Optional: full path to the qloo binary if it isn't on PATH
# (Windows: run `where.exe qloo`).
# QLOO_BIN=
